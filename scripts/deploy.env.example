# Địa chỉ máy chủ triển khai — BẢN MẪU.
#
#     cp scripts/deploy.env.example scripts/deploy.env
#
# `scripts/deploy.env` BỊ GITIGNORE. Ba giá trị dưới đây không phải bí mật
# (không ai đăng nhập được chỉ bằng chúng), nhưng gộp lại là một tấm bản đồ khá
# đầy đủ cho người muốn thử cửa — và repo này công khai.
#
# Biến môi trường vẫn thắng file này, nên vẫn deploy được sang máy khác mà không
# phải sửa gì:
#     AC_HOST=1.2.3.4 scripts/deploy.sh

# IP hoặc tên máy chủ, dùng cho ssh/scp.
AC_HOST=1.2.3.4

# Tài khoản SSH trên máy đó.
AC_USER=ten-tai-khoan

# URL công khai của web quản trị. Script gọi nó để kiểm tra sức khoẻ sau khi
# deploy — phải là địa chỉ đi qua Cloudflare Tunnel, không phải IP trần.
AC_URL=https://quan-tri.vi-du.com

# --- Không bắt buộc: chỉ đặt khi khác mặc định ---
# AC_REMOTE_DIR=aircon                        # thư mục trong $HOME trên server
# AC_PROJECT=aircon                           # tên project của docker compose
# AC_COMPOSE=docker/docker-compose.vps.yml    # file compose dùng để build
