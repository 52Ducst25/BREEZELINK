#pragma once
// ============================================================================
//  BreezeLink - ESP32 DevKit V1  -  OUTDOOR node
//  TEMPLATE -- copy to `config.h` and fill it in. (config.h is gitignored because
//  it holds the real WiFi password + MQTT token.)
// ============================================================================
//  Get the values from: Admin web -> Khách hàng -> open the node (Ngoài trời) ->
//  "Nạp firmware".
//  DEVICE_UUID/MQTT_PASSWORD differ from the indoor node; ORG_ID + MQTT_HOST are
//  the same.
// ============================================================================

// -------- 1) WiFi --------
//  The `esp32-espnow` env does NOT join WiFi -- it only SCANS to learn which
//  channel the router is broadcasting on and locks onto it (ESP-NOW requires both
//  sides on the same channel). So with that env only WIFI_SSID matters, and
//  WIFI_PASSWORD can be left as-is.
//  The `esp32-wifi` env (the fallback) needs both.
#define WIFI_SSID      "WIFI_NAME"
#define WIFI_PASSWORD  "WIFI_PASSWORD"

// -------- 2) MQTT (self-hosted EMQX on the VPS -- plaintext 1883, NO TLS) -----
//  Only used by the `esp32-wifi` env. The web panel prints MQTT_HOST = "emqx"
//  (the internal Docker service name) -- the ESP has to use the server's public
//  IP/domain.
#define MQTT_HOST      "SERVER_PUBLIC_IP"
#define MQTT_PORT      1883
#define MQTT_USERNAME  "PASTE_DEVICE_UUID_OUTDOOR"
#define MQTT_PASSWORD  "PASTE_MQTT_PASSWORD_OUTDOOR"

// -------- 3) Node identity (matches the devices row on the web UI) --------
//  DEVICE_UUID is used by BOTH envs: the ESP-NOW version includes this uuid in
//  the packet so the indoor node knows which topic to publish to without any
//  MAC->uuid table.
#define ORG_ID         "PASTE_ORG_ID"
#define DEVICE_UUID    "PASTE_DEVICE_UUID_OUTDOOR"
#define FW_VERSION     "outdoor-1.0"

// ============================================================================
//  Hardware -- wire the sensor as described in ../README.md
// ============================================================================
//  DHT sensor:  VCC -> 3V3 | GND -> GND | DATA -> GPIO4
//
//  POWER IT FROM 3.3V, NOT 5V: the ESP32-C3 pins do not tolerate overvoltage, and
//  a 5V-powered DHT22 drives the data line up towards 5V.
//
//  The DHT22 uses a BIDIRECTIONAL ONE-WIRE protocol -- a 4.7k pull-up to 3.3V on
//  the data line is mandatory (3-pin modules have it fitted; a bare 4-pin sensor
//  needs one added). Without it, reads succeed intermittently: the checksum
//  catches the bad ones so you get NO wrong numbers, just interleaved NaN -- a
//  symptom that looks a lot like a loose wire.
//
//  CHOOSING PINS ON THE ESP32-C3 -- the pins you MUST AVOID (quite different from
//  the old ESP32 board):
//    GPIO2, GPIO8, GPIO9   strapping. GPIO9 is the BOOT button: a DHT22 with its
//                          pull-up holds it HIGH and the board loses the ability
//                          to enter programming mode.
//    GPIO18, GPIO19        USB D-/D+. Using them as GPIO costs you the flashing
//                          port entirely.
//    GPIO11..17            wired to the SPI flash inside the module. Touch them
//                          and the board dies instantly.
//    GPIO20, GPIO21        UART0. Usable, but you lose the serial log.
//  GPIO4 is clean on both board families, so the board change needed no pin
//  change.
#define DHT_PIN        4
//  SENSOR TYPE -- a DHTesp type, NOT Adafruit's DHT22 macro.
//  The library changed at the same time as the board (see platformio.ini), so
//  declaring a bare `DHT22` here breaks the build at "'DHT22' was not declared in
//  this scope".
//
//  SET THE RIGHT TYPE: getting it wrong still reads successfully and still passes
//  the checksum, it just produces nonsense values -- a DHT22 declared as a DHT11
//  gives about 1.8 degC / 23%.
#define DHT_TYPE       DHTesp::DHT22

//  Telemetry interval (ms). 15s is convenient while testing; 30000 in production.
//  5 SECONDS when running ESP-NOW, NOT 15. This is a HEARTBEAT, not a
//  data-logging cadence: the gateway already throttles the push to the cloud at
//  15s (SlaveWatch::RELAY_INTERVAL_MS), so broadcasting more often adds NO extra
//  telemetry rows.
//
//  Why it has to be frequent: ESP-NOW broadcast has no ACK, so a dropped packet
//  is gone for good. Measured on real hardware: the node transmitted at seconds
//  8/23/38/53 and the gateway only received the one at second 23. At a 15s
//  cadence with SlaveWatch's 20s disconnection threshold, LOSING A SINGLE PACKET
//  marks the node OFFLINE -- the gateway log flickered ONLINE/OFFLINE constantly
//  while the node was transmitting perfectly steadily. 5s tolerates three
//  consecutive misses while still counting as alive.
//
//  For the direct-WiFi version 15s is still correct: TCP acknowledges, so nothing
//  is dropped silently.
#define TELEMETRY_MS   5000UL
