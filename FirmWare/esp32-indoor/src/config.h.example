#pragma once
// ============================================================================
//  BreezeLink — QR Box Advance Touch Screen  ·  node TRONG NHÀ (indoor) + MASTER + IR
//  BẢN MẪU — copy thành `config.h` rồi điền. (config.h bị gitignore vì chứa
//  mật khẩu WiFi + token MQTT thật.)
// ============================================================================
//  Lấy ORG_ID / DEVICE_UUID / MQTT_PASSWORD ở đâu?
//    Web admin -> Khách hàng -> mở node (Trong nhà) -> mục "Nạp firmware".
//    MQTT_USERNAME luôn = DEVICE_UUID.
//
//  QUAN TRỌNG — ĐẶT VAI TRÒ MẠNG CỦA NODE NÀY LÀ **MASTER** TRÊN WEB:
//    backend chọn "node nào nhận lệnh điều khiển" bằng role=master trước, rồi
//    mới rơi về node_type=indoor cũ nhất (telemetry_service.get_gateway_device).
//    Không đặt master thì hộ nào có hai hàng indoor sẽ bị lái nhầm node, và
//    triệu chứng là lệnh publish thành công mà máy lạnh không nhúc nhích.
// ============================================================================

// -------- 1) WiFi --------
#define WIFI_SSID      "TEN_WIFI"
#define WIFI_PASSWORD  "MAT_KHAU_WIFI"

// -------- 2) MQTT (EMQX tự host trên VPS — plaintext 1883, KHÔNG TLS) --------
//  LƯU Ý: panel web ghi MQTT_HOST = "emqx" — đó là tên service nội bộ Docker,
//  ESP không phân giải được. Phải dùng IP/domain công khai của server.
#define MQTT_HOST      "IP_CONG_KHAI_SERVER"
#define MQTT_PORT      1883
//  Broker đã bật authentication (built-in DB): user = DEVICE_UUID, pass = token.
#define MQTT_USERNAME  "DAN_DEVICE_UUID"
#define MQTT_PASSWORD  "DAN_MQTT_PASSWORD"

// -------- 3) Định danh node (khớp hàng devices trên web) --------
#define ORG_ID         "DAN_ORG_ID"
#define DEVICE_UUID    "DAN_DEVICE_UUID"
#define FW_VERSION     "gateway-2.0"

// -------- 4) Bảng node cảm biến góc phòng --------
//  THỨ TỰ LÀ HỢP ĐỒNG: ô số i phải là device_uuid của bo đã nạp ROOM_NODE_ID = i.
//
//  Vì sao gateway phải giữ bảng này thay vì để node tự khai như ESP-NOW: gói BLE
//  chỉ có 20 byte (advertising cổ điển giới hạn 31 byte), không nhét nổi một
//  uuid 32 ký tự — xem shared/ble-mesh-message.h. Đánh đổi: thêm/bớt node phòng
//  là PHẢI nạp lại gateway.
//
//  LỆCH MỘT Ô LÀ HỎNG CÂM: số đo của góc A được nộp lên cloud dưới tên góc B.
//  Biểu đồ vẫn có số, không lỗi ở đâu cả, chỉ là hai góc bị hoán tên vĩnh viễn.
//  Trang web "Nạp firmware" của bất kỳ node phòng nào in sẵn cả mảng này — chép
//  nguyên cụm thay vì gõ tay từng uuid.
//
//  Ô để chuỗi rỗng "" = chưa lắp góc đó; gateway bỏ qua node_id tương ứng.
#define ROOM_NODE_UUIDS { "DAN_UUID_GOC_0", "DAN_UUID_GOC_1", \
                          "DAN_UUID_GOC_2", "DAN_UUID_GOC_3" }

// ============================================================================
//  Phần cứng — bo QR Box Advance Touch Screen
// ----------------------------------------------------------------------------
//  Cách đọc ngược sơ đồ chân từ schematic + thiết kế giao diện:
//  ../../Interface/README.md
//
//  CHÂN IR KHÔNG KHAI Ở ĐÂY. `IR_TX_PIN` (5) và `IR_RX_PIN` (17) nằm trong
//  build_flags của platformio.ini, cùng chỗ với các cờ TFT_* — vì cả hai nhóm
//  đều phải có mặt lúc biên dịch THƯ VIỆN, không chỉ lúc biên dịch src/. Lý do
//  chọn từng chân + các bẫy phần cứng: đọc khối chú thích đầu platformio.ini,
//  và Interface/README.md §3.
//
//  BO NÀY KHÔNG CÒN CẢM BIẾN NHIỆT/ẨM. Cả DHT22 lẫn SHT3x đã bỏ khỏi firmware:
//  số "trong nhà" nay là trung vị của các node góc phòng (ROOM_NODE_UUIDS ở
//  trên). Một cảm biến treo trên tường chỉ nói được nhiệt độ của cái tường đó.
// ============================================================================

//  Thời gian chờ người dùng bấm remote khi vào chế độ HỌC (ms).
//  30s: đủ để đi từ chỗ đặt node tới chỗ cầm remote, chưa lâu tới mức người
//  lắp tưởng máy treo.
#define LEARN_TIMEOUT_MS  30000UL

//  Chu kỳ gửi số liệu (ms). 15s cho dễ theo dõi khi test; 30000 khi chạy thật.
#define TELEMETRY_MS   15000UL

// ----------------------------------------------------------------------------
//  Bus I2C dùng chung: cảm ứng màn (0x38/0x5D/0x15) + DS1307 (0x68) + SHT3x (0x44).
//  ĐỪNG nâng lên 400kHz — DS1307 chỉ chịu 100kHz, xem Interface/README.md §2.1.
// ----------------------------------------------------------------------------
#define I2C_SCL_PIN        4
#define I2C_SDA_PIN        16
#define TOUCH_RST_PIN      25
#define TOUCH_INT_PIN      33

//  Đèn nền qua Q5 (BSS138 hạ áp phía mát): mức CAO = sáng, PWM được.
#define LCD_BACKLIGHT_PIN  27
#define BUZZER_PIN         13

//  OE của TXS0104 (bộ dịch mức cho UART_1 ra cổng P3).
//
//  DHT22 (GPIO2 = UART_1_RX) ĐI QUA IC NÀY — nên chân này là điều kiện sống còn
//  của phép đo nhiệt/ẩm. OE thấp thì ngõ ra treo lơ lửng và cảm biến ra NaN mãi.
//  (IR thì không: cả phát GPIO5 lẫn thu GPIO17 đều nối 3.3V thẳng.)
//
//  PHẢI đặt trong setup() chứ không kéo bằng trở ngoài: GPIO12 = MTDI, HIGH
//  lúc reset thì ROM chọn mức flash 1.8V và bo không boot. Trên bo này R7 10k
//  kéo GPIO12 XUỐNG GND — đúng chuẩn (đã đối chiếu schematic).
#define EN_LEVEL_SHIFT_PIN 12

//  1 hoặc 3 = nằm ngang 320x240 (panel gốc là 240x320 dọc, xoay bằng phần mềm).
//  Bo này dùng 1 — đã đo trên bo thật: 3 cho ra hình ĐÚNG NHƯNG LỘN NGƯỢC 180 độ.
#define TFT_ROTATION       1

//  Xoay/lật toạ độ cảm ứng về hệ của TFT. Mỗi lô module dán tấm cảm ứng lệch
//  trục khác nhau và schematic không nói gì — chạm thử rồi chỉnh ba cờ này.
#define TOUCH_SWAP_XY      1
#define TOUCH_INVERT_X     0
#define TOUCH_INVERT_Y     1

//  KHÔNG CÒN TZ_INFO: nút "ĐỒNG BỘ GIỜ" và cả đường NTP đã bỏ. Node chỉ ĐỌC
//  DS1307 để hiện giờ trên thanh trạng thái, không đặt giờ nữa — đặt bằng công
//  cụ khác, chip có pin nuôi riêng nên một lần là giữ.
