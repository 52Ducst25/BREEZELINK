#pragma once
// ============================================================================
//  BreezeLink — QR Box Advance Touch Screen  ·  node TRONG NHÀ (indoor) + MASTER + IR
//  BẢN MẪU — copy thành `config.h` rồi điền. (config.h bị gitignore vì chứa
//  mật khẩu WiFi + token MQTT thật.)
// ============================================================================
//  Lấy ORG_ID / DEVICE_UUID / MQTT_PASSWORD ở đâu?
//    Web admin -> Khách hàng -> mở node (Trong nhà) -> mục "Nạp firmware".
//    MQTT_USERNAME luôn = DEVICE_UUID.
//
//  QUAN TRỌNG — ĐẶT VAI TRÒ MẠNG CỦA NODE NÀY LÀ **MASTER** TRÊN WEB:
//    backend chọn "node nào nhận lệnh điều khiển" bằng role=master trước, rồi
//    mới rơi về node_type=indoor cũ nhất (telemetry_service.get_gateway_device).
//    Không đặt master thì hộ nào có hai hàng indoor sẽ bị lái nhầm node, và
//    triệu chứng là lệnh publish thành công mà máy lạnh không nhúc nhích.
// ============================================================================

// -------- 1) WiFi --------
#define WIFI_SSID      "TEN_WIFI"
#define WIFI_PASSWORD  "MAT_KHAU_WIFI"

// -------- 2) MQTT (EMQX tự host trên VPS — plaintext 1883, KHÔNG TLS) --------
//  LƯU Ý: panel web ghi MQTT_HOST = "emqx" — đó là tên service nội bộ Docker,
//  ESP không phân giải được. Phải dùng IP/domain công khai của server.
#define MQTT_HOST      "IP_CONG_KHAI_SERVER"
#define MQTT_PORT      1883
//  Broker đã bật authentication (built-in DB): user = DEVICE_UUID, pass = token.
#define MQTT_USERNAME  "DAN_DEVICE_UUID"
#define MQTT_PASSWORD  "DAN_MQTT_PASSWORD"

// -------- 3) Định danh node (khớp hàng devices trên web) --------
#define ORG_ID         "DAN_ORG_ID"
#define DEVICE_UUID    "DAN_DEVICE_UUID"
#define FW_VERSION     "gateway-2.0"

// -------- 4) Node cảm biến góc phòng: KHÔNG PHẢI KHAI GÌ Ở ĐÂY --------
//  Trước đây chỗ này có một mảng ROOM_NODE_UUIDS, và thêm/bớt một góc là phải
//  nạp lại gateway. Nó đã bỏ khi các node góc chuyển sang ESP-NOW: gói ESP-NOW
//  chở được 250 byte nên mỗi node mang thẳng device_uuid 32 ký tự của chính nó
//  (../../shared/espnow-message.h). Gateway cứ thế publish hộ vào topic của node
//  đó — nó không cần biết trước có bao nhiêu góc, cũng không cần biết góc nào là
//  góc nào.
//
//  Kèm theo đó là mất hẳn một lớp lỗi: mảng cũ lệch một ô thì số đo của góc A
//  được nộp lên cloud dưới tên góc B, biểu đồ vẫn có số, không lỗi ở đâu cả, và
//  hai góc bị hoán tên vĩnh viễn.
//
//  Node góc phòng cấu hình ở ../../esp32-room/src/config.h — mỗi bo một
//  DEVICE_UUID riêng, lấy trên web ở mục "Nạp firmware" của chính node đó.

// ============================================================================
//  Phần cứng — bo QR Box Advance Touch Screen
// ----------------------------------------------------------------------------
//  Cách đọc ngược sơ đồ chân từ schematic + thiết kế giao diện:
//  ../../Interface/README.md
//
//  CHÂN IR KHÔNG KHAI Ở ĐÂY. `IR_TX_PIN` (5) và `IR_RX_PIN` (17) nằm trong
//  build_flags của platformio.ini, cùng chỗ với các cờ TFT_* — vì cả hai nhóm
//  đều phải có mặt lúc biên dịch THƯ VIỆN, không chỉ lúc biên dịch src/. Lý do
//  chọn từng chân + các bẫy phần cứng: đọc khối chú thích đầu platformio.ini,
//  và Interface/README.md §3.
//
//  BO NÀY KHÔNG CÒN CẢM BIẾN NHIỆT/ẨM. Cả DHT22 lẫn SHT3x đã bỏ khỏi firmware:
//  số "trong nhà" nay là trung vị của các node góc phòng (ROOM_NODE_UUIDS ở
//  trên). Một cảm biến treo trên tường chỉ nói được nhiệt độ của cái tường đó.
// ============================================================================

//  Thời gian chờ người dùng bấm remote khi vào chế độ HỌC (ms).
//  30s: đủ để đi từ chỗ đặt node tới chỗ cầm remote, chưa lâu tới mức người
//  lắp tưởng máy treo.
#define LEARN_TIMEOUT_MS  30000UL

//  Chu kỳ gửi số liệu (ms). 15s cho dễ theo dõi khi test; 30000 khi chạy thật.
#define TELEMETRY_MS   15000UL

// ----------------------------------------------------------------------------
//  SƠ ĐỒ CHÂN KHÔNG NẰM Ở ĐÂY NỮA — xem board-pins.h
// ----------------------------------------------------------------------------
//  Chân (I2C, cảm ứng, đèn nền, còi, xoay màn) đã chuyển sang board-pins.h vì
//  chúng thuộc về BO, còn file này thuộc về HỘ. Firmware panel nay chạy trên hai
//  bo khác nhau (QR Box Advance và bo 2.8" ESP32-S3) dùng CHUNG một hàng
//  `devices` trên web — tức chung file này, nhưng chân thì khác hoàn toàn.
//
//  Đổi bo: khai cờ -D BOARD_* trong platformio.ini, KHÔNG sửa file này.
#include "board-pins.h"

//  KHÔNG CÒN TZ_INFO ở đây: múi giờ là hằng số trong ui/board-io.cpp (sản phẩm
//  bán trong nước, thêm một ô cho người lắp điền là thêm một chỗ điền sai).
