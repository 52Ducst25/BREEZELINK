#pragma once
// ============================================================================
//  BreezeLink - QR Box Advance Touch Screen  -  INDOOR node + MASTER + IR
//  TEMPLATE -- copy to `config.h` and fill it in. (config.h is gitignored because
//  it holds the real WiFi password + MQTT token.)
// ============================================================================
//  Where do I get ORG_ID / DEVICE_UUID / MQTT_PASSWORD?
//    Admin web -> Khách hàng -> open the node (Trong nhà) -> the "Nạp firmware"
//    section.
//    MQTT_USERNAME is always = DEVICE_UUID.
//
//  IMPORTANT -- SET THIS NODE'S NETWORK ROLE TO **MASTER** ON THE WEB UI:
//    the backend picks "which node receives control commands" by looking for
//    role=master first, only then falling back to the oldest node_type=indoor
//    (telemetry_service.get_gateway_device).
//    Without the master role, a household with two indoor rows will drive the
//    wrong node, and the symptom is a command that publishes successfully while
//    the air conditioner does not move.
// ============================================================================

// -------- 1) WiFi --------
#define WIFI_SSID      "WIFI_NAME"
#define WIFI_PASSWORD  "WIFI_PASSWORD"

// -------- 2) MQTT (self-hosted EMQX on the VPS -- plaintext 1883, NO TLS) -----
//  NOTE: the web panel prints MQTT_HOST = "emqx" -- that is the internal Docker
//  service name, which an ESP cannot resolve. You must use the server's public
//  IP/domain.
#define MQTT_HOST      "SERVER_PUBLIC_IP"
#define MQTT_PORT      1883
//  The broker has authentication enabled (built-in DB): user = DEVICE_UUID,
//  pass = token.
#define MQTT_USERNAME  "PASTE_DEVICE_UUID"
#define MQTT_PASSWORD  "PASTE_MQTT_PASSWORD"

// -------- 3) Node identity (matches the devices row on the web UI) --------
#define ORG_ID         "PASTE_ORG_ID"
#define DEVICE_UUID    "PASTE_DEVICE_UUID"
#define FW_VERSION     "gateway-2.0"

// -------- 4) Room-corner sensor nodes: NOTHING TO DECLARE HERE --------
//  This used to hold a ROOM_NODE_UUIDS array, and adding or removing a corner
//  meant reflashing the gateway. It went away when the corner nodes moved to
//  ESP-NOW: an ESP-NOW frame carries 250 bytes, so each node carries its own
//  32-character device_uuid directly (../../shared/espnow-message.h). The gateway
//  simply publishes on that node's behalf to that node's topic -- it does not need
//  to know in advance how many corners there are, nor which corner is which.
//
//  That also removed an entire class of bug: with the old array, one slot out of
//  place meant corner A's readings landed in the cloud under corner B's name, the
//  charts still showed numbers, nothing anywhere reported an error, and the two
//  corners stayed permanently swapped.
//
//  Room-corner nodes are configured in ../../esp32-room/src/config.h -- one
//  DEVICE_UUID per board, taken from that node's own "Nạp firmware" section on the
//  web UI.

// ============================================================================
//  Hardware -- the QR Box Advance Touch Screen board
// ----------------------------------------------------------------------------
//  How the pinout was reverse-engineered from the schematic, plus the UI design:
//  ../../Interface/README.md
//
//  THE IR PINS ARE NOT DECLARED HERE. `IR_TX_PIN` (5) and `IR_RX_PIN` (17) live in
//  platformio.ini's build_flags alongside the TFT_* flags -- because both groups
//  have to be present while compiling the LIBRARIES, not only while compiling
//  src/. The reasoning behind each pin choice plus the hardware traps: read the
//  comment block at the top of platformio.ini, and Interface/README.md §3.
//
//  THIS BOARD NO LONGER HAS A TEMPERATURE/HUMIDITY SENSOR. Both the DHT22 and the
//  SHT3x have been removed from the firmware: the "indoor" number is now the
//  median of the room-corner nodes. A sensor on a wall only tells you the
//  temperature of that wall.
// ============================================================================

//  How long to wait for the user to press the remote in LEARN mode (ms).
//  30s: long enough to walk from the node to wherever the remote is, not so long
//  that the installer thinks the device has hung.
#define LEARN_TIMEOUT_MS  30000UL

//  Telemetry interval (ms). 15s is convenient while testing; 30000 in production.
#define TELEMETRY_MS   15000UL

// ----------------------------------------------------------------------------
//  THE PINOUT IS NO LONGER HERE -- see board-pins.h
// ----------------------------------------------------------------------------
//  The pins (I2C, touch, backlight, buzzer, screen rotation) moved to
//  board-pins.h because they belong to the BOARD, while this file belongs to the
//  HOUSEHOLD. The panel firmware now runs on two different boards (QR Box Advance
//  and the 2.8" ESP32-S3 board) sharing one `devices` row on the web UI -- i.e.
//  sharing this file, while their pins are completely different.
//
//  Changing board: declare a -D BOARD_* flag in platformio.ini, do NOT edit this
//  file.
#include "board-pins.h"

//  TZ_INFO IS NO LONGER HERE: the timezone is a constant in ui/board-io.cpp (a
//  domestically sold product, and one more field for the installer to fill in is
//  one more field to fill in wrongly).
