#pragma once
// ============================================================================
//  BreezeLink - ESP32-C3-DevKitM-1 - ROOM-CORNER SENSOR node
//  TEMPLATE -- copy to `config.h` and fill it in. (config.h is gitignored.)
// ============================================================================
//  This node does NOT join WiFi and does NOT connect to MQTT -- it only
//  broadcasts ESP-NOW to the gateway, which publishes on its behalf. So there is
//  NO MQTT_PASSWORD here, and the WIFI_SSID below comes without a password: the
//  node only *scans* for the network name to learn which channel the router is
//  on; it never joins.
//
//  Where do I get DEVICE_UUID?
//    Admin web -> Khách hàng -> open the node (Cảm biến phòng) -> the
//    "Nạp firmware" section.
//    Each corner is its OWN device row on the web UI, so EVERY BOARD NEEDS A
//    DIFFERENT UUID.
// ============================================================================

// -------- 1) The household WiFi network name (ONLY for channel discovery) -----
//  It MUST MATCH the string in the gateway's config.h exactly, and it must be a
//  2.4 GHz network.
//
//  This is ESP-NOW's silent-failure number one: both sides must be on the same
//  channel, and this node infers the channel by scanning for this exact name. One
//  wrong character (or a 5 GHz network name) and the node stays on default
//  channel 1, the frames go nowhere, and since broadcast has NO ACK not a single
//  log line anywhere reports a problem.
#define WIFI_SSID   "WIFI_NAME_2G"

#define FW_VERSION  "room-1.0"

// -------- 2) DEVICE_UUID and ROOM_CORNER ARE NO LONGER HERE --------
//  They live in `nodes.ini` (next to platformio.ini), one env per node, and reach
//  the code through build_flags.
//
//  WHY THEY MOVED: there is only ONE of this file, but the four boards differ in
//  exactly those two lines. Flashing the third board meant editing the file and
//  flashing, then editing again and flashing the fourth -- and there was no way to
//  look at the directory and tell which board's identity it was holding. SS2's
//  uuid once got flashed onto the SS4 board for exactly that reason.
//
//  Now each board is one command with no file edits:
//      pio run -e ss1 -t upload --upload-port COM30
//
//  What remains here is what ALL FOUR BOARDS SHARE (the WiFi name, the firmware
//  version) -- which is also the boundary for deciding where anything new belongs.

// ============================================================================
//  Hardware
// ----------------------------------------------------------------------------
//  DHT_PIN is declared in platformio.ini (GPIO4 by default), alongside the other
//  build flags. The reasoning behind the pin choice and the pins to avoid on the
//  C3: see the comment block at the top of platformio.ini.
//
//  Power: this version runs from 5V USB and does NOT monitor a battery. Battery
//  operation would need deep sleep -- ESP-NOW suits that very well (there is no
//  WiFi/DHCP/TCP handshake to redo after each wake) -- but it has not been done.
// ============================================================================
