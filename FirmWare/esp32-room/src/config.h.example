#pragma once
// ============================================================================
//  BreezeLink — ESP32-C3-DevKitM-1 · node CẢM BIẾN GÓC PHÒNG
//  BẢN MẪU — copy thành `config.h` rồi điền. (config.h bị gitignore.)
// ============================================================================
//  Node này KHÔNG nối WiFi và KHÔNG nối MQTT — nó chỉ bắn ESP-NOW về gateway,
//  gateway đứng tên publish hộ. Nên ở đây KHÔNG có MQTT_PASSWORD, và WIFI_SSID
//  dưới đây KHÔNG kèm mật khẩu: node chỉ *quét* tên mạng để biết router đang ở
//  kênh nào, không hề đăng nhập.
//
//  Lấy DEVICE_UUID ở đâu?
//    Web admin -> Khách hàng -> mở node (Cảm biến phòng) -> mục "Nạp firmware".
//    Mỗi góc là MỘT hàng device riêng trên web, nên MỖI BO MỘT UUID KHÁC NHAU.
// ============================================================================

// -------- 1) Tên mạng WiFi của nhà (CHỈ để dò kênh) --------
//  PHẢI GIỐNG HỆT chuỗi trong config.h của gateway, và phải là băng 2.4 GHz.
//
//  Đây là chỗ hỏng câm số một của ESP-NOW: hai bên bắt buộc cùng kênh, mà node
//  này suy ra kênh bằng cách quét đúng chuỗi tên này. Gõ lệch một ký tự (hoặc
//  điền tên băng 5 GHz) thì node bám kênh 1 mặc định, gói bay vào khoảng không,
//  và vì broadcast KHÔNG CÓ ACK nên không một dòng log nào ở bất kỳ đâu báo lỗi.
#define WIFI_SSID   "TEN_WIFI_2G"

// -------- 2) Định danh node (khớp hàng devices trên web) --------
#define DEVICE_UUID "DAN_DEVICE_UUID"
#define FW_VERSION  "room-1.0"

// -------- 3) Nhãn góc hiển thị trên màn tại chỗ --------
//  0..3 cho bốn góc. CHỈ LÀ NHÃN: định danh thật là DEVICE_UUID ở trên.
//
//  Nên hai bo trùng số ở đây là VÔ HẠI — cả hai vẫn có topic riêng, vẫn vào
//  trung vị, chỉ là màn hình ghi nhãn trùng nhau. Đặt đúng thì người đi bảo trì
//  đọc màn là biết ngay góc nào đang lệch mà không phải tra uuid.
#define ROOM_CORNER 0

// ============================================================================
//  Phần cứng
// ----------------------------------------------------------------------------
//  DHT_PIN khai trong platformio.ini (mặc định GPIO4), cùng chỗ với các cờ build
//  khác. Lý do chọn chân + những chân phải tránh trên C3: xem khối chú thích đầu
//  platformio.ini.
//
//  Cấp nguồn: bản này chạy nguồn USB 5V và KHÔNG đo pin. Muốn chạy pin thì phải
//  thêm deep-sleep — ESP-NOW rất hợp với việc đó (không có bắt tay WiFi/DHCP/TCP
//  nào phải làm lại sau mỗi lần thức), nhưng chưa làm.
// ============================================================================
