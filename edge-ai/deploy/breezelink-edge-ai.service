[Unit]
Description=BreezeLink Edge AI (local comfort + fallback when the cloud is gone)
Documentation=file:///home/arduino/breezelink/edge-ai/README.md
# WANT the network, do not REQUIRE it: the broker may be on the LAN and come up later,
# and this service reconnects with backoff by itself. Using Requires= would turn a
# slow-starting broker into a service that never runs.
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# RUNS AS `arduino`, WITH NO DEDICATED USER — and this is a technical reason, not
# laziness: the service talks to BlueZ over D-Bus, and BlueZ's D-Bus policy grants
# access per user. `arduino` is the UNO Q board's existing user and is already in the
# bluetooth group. A brand-new user would be refused by org.bluez, and the symptom
# would be a BLE scan returning empty forever rather than a clear permission error.
User=arduino
Group=arduino
# IT LIVES IN /home/arduino AND NOT /opt — because sudo on THIS board asks for a
# password. Under /opt every update would need a sudo to write, i.e. remote deployment
# would become impossible. In the home directory the `arduino` user can write it
# itself, and sudo is only needed ONCE, to place this unit into /etc/systemd/system.
WorkingDirectory=/home/arduino/breezelink
Environment=PYTHONUNBUFFERED=1
# payload/ contains BOTH `edge_ai/` and the backend's `app/` slice — a single PYTHONPATH
# entry makes both importable, so EDGE_BACKEND_SRC is unnecessary.
Environment=PYTHONPATH=/home/arduino/breezelink/payload
EnvironmentFile=/home/arduino/breezelink/.env
ExecStart=/home/arduino/breezelink/.venv/bin/python -m edge_ai.main

# Restart=always rather than on-failure: the service exits 0 on SIGTERM, and an
# unintended stop still has to come back. The exception is a configuration error — it
# exits 1, and RestartSec=10 keeps the retry rate sparse enough that the log line
# explaining it does not scroll away.
Restart=always
RestartSec=10

# Tighten permissions: this service only needs to read its own source and open an MQTT
# socket. It does NOT need to write anywhere.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=false IS MANDATORY because the source lives in /home/arduino/breezelink —
# enabling it makes systemd hide /home and the service cannot find itself.
# Compensated by the ReadOnlyPaths just below: readable, not writable.
ProtectHome=false
ReadOnlyPaths=/home/arduino/breezelink

[Install]
WantedBy=multi-user.target
