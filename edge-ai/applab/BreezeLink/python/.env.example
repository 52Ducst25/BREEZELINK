# BreezeLink Edge AI — bản App Lab (chạy trên Arduino UNO Q).
#
#   copy thành .env rồi điền:   cp .env.example .env
#
# .env BỊ GITIGNORE và build-applab-app.py CỐ Ý KHÔNG XOÁ NÓ (chỉ dựng lại
# edge_ai/ và app/). Nó chứa ORG_ID của hộ — thứ không có bản nào khác để khôi
# phục nếu mất.
#
# KHÔNG CÓ CREDENTIAL MQTT Ở ĐÂY, và đó là điểm mấu chốt: dịch vụ này nói chuyện
# với gateway qua UART, không qua broker. Chính vì vậy nó sống sót được đúng sự
# cố mất mạng mà nó sinh ra để chịu đựng.

# =============================================================================
#  BẮT BUỘC
# =============================================================================
# Lấy ở web admin -> Khách hàng -> mở node "Gateway trong nhà" -> "Nạp firmware".
#
# Giá trị này được BĂM thành `link_key` mà gateway đối chiếu trên từng gói. Sai
# ORG_ID thì gateway lặng lẽ từ chối mọi lệnh: log của NÓ ghi "tu choi goi sai
# link_key", còn log của node này KHÔNG GHI GÌ CẢ — nó gửi thành công, chỉ là
# đầu kia vứt đi. Triệu chứng duy nhất là "máy lạnh không nhúc nhích".
EDGE_ORG_ID=

# =============================================================================
#  ĐƯỜNG TỚI GATEWAY
# =============================================================================
# auto (mặc định) | bridge | serial
#
#   bridge  đi qua sketch trên nửa STM32 rồi ra chân D0/D1  <- ĐÚNG cho App Lab
#   serial  đi qua cổng USB-TTL của nửa Linux
#
# "auto" dò xem /var/run/arduino-router.sock có tồn tại không. Chạy trong App Lab
# thì nó luôn chọn bridge, nên thường KHÔNG PHẢI ĐIỀN GÌ.
#
# HAI ĐƯỜNG NÀY KHÔNG THỂ CÙNG ĐÚNG — dây chỉ cắm được vào một chỗ. Cắm vào
# D0/D1 mà ép serial thì pyserial vớ đại một cổng khác rồi ngồi chờ mãi mãi, và
# triệu chứng ("không thấy ảnh chụp") giống hệt đứt dây.
# EDGE_LINK=auto

# Chỉ dùng khi EDGE_LINK=serial. Để trống là tự dò (ưu tiên chip cầu
# CH34x/CP210x/FTDI). Phải khai tay khi nối thẳng chân UART: Linux không đoán
# được /dev/ttyS* nào đang nối vào đâu.
# EDGE_UART_PORT=/dev/ttyUSB0

# =============================================================================
#  MÃ IR ĐÃ HỌC — nên điền, xem cái bẫy bên dưới
# =============================================================================
# Những mức nhiệt độ hộ này ĐÃ HỌC MÃ IR ở chế độ COOL.
#
# Phải khai tay vì node edge không có đường tới Postgres — bảng `ir_codes` nằm
# trên máy chủ, mà cả lý do tồn tại của node này là chạy tiếp khi mất máy chủ.
#
# Lấy danh sách thật bằng:
#     SELECT DISTINCT temp FROM ir_codes WHERE mode='COOL' ORDER BY temp;
#
# BỎ TRỐNG KHÔNG PHẢI LÀ AN TOÀN. Lúc đó node tự học bằng cách quan sát máy chủ
# ra lệnh, và ngay sau khi khởi động nó mới thấy đúng MỘT mức (vd 27).
# nearest_captured_temp() luôn trả về mức gần nhất trong danh sách nó đang có —
# nên mục tiêu 24.5 bị ép thành 27, không lỗi, không cảnh báo. Danh sách lấp một
# nửa NGUY HIỂM HƠN danh sách rỗng: rỗng thì NoIrCodesError chặn lại.
# EDGE_IR_TEMPS=24,25,26,27,28

# =============================================================================
#  DỰ BÁO THỜI TIẾT (open-meteo, không cần khoá API)
# =============================================================================
# Toạ độ nơi lắp. PHẢI CÓ ĐỦ CẢ HAI hoặc bỏ trống cả hai — khai một trong hai là
# lỗi cấu hình chứ không phải "tắt", vì nó gần như chắc chắn là gõ sót.
#
# Bỏ trống thì mô hình nhiệt vẫn chạy, nhưng khi nhìn xa hơn ~15 phút nó phải
# giả định trời ngoài đứng yên.
# EDGE_LAT=10.701285
# EDGE_LON=106.625595

# =============================================================================
#  QUYỀN RA LỆNH
# =============================================================================
# 1/true/yes = CHỈ ĐỀ XUẤT, không bao giờ ra lệnh — kể cả khi mất cloud.
#
# Bật khi chạy thử để đối chiếu quyết định của edge với quyết định của máy chủ
# TRƯỚC KHI giao quyền thật. Chỉ tắt sau khi trang theo dõi (cổng 7000) báo dự
# báo ĐÁNG TIN.
EDGE_ADVISORY_ONLY=1

# Im lặng bao lâu từ phía máy chủ thì UNO Q giành quyền lái (giây).
# 300 rộng có chủ đích: hai bên cùng ra lệnh thì máy lạnh nhận hai lệnh trái
# nhau trong cùng một phút, và triệu chứng (nhiệt độ tự nhảy) trông y hệt lỗi
# thuật toán. Thà giành muộn.
# EDGE_TAKEOVER_AFTER_SEC=300

# =============================================================================
#  LỊCH SỬ CỤC BỘ (SQLite) — nền của mô hình nhiệt
# =============================================================================
# Không có nó thì mỗi lần khởi động lại dịch vụ là mô hình quay về 0 và mất
# khoảng 10 giờ mới dùng được.
#
# ĐỂ TRỐNG LÀ ĐÚNG. Mặc định là data/ cạnh gói edge_ai, tức trong thư mục app —
# chỗ DUY NHẤT của App Lab vừa ghi được vừa sống sót qua lần dựng lại container.
# Mọi đường dẫn khác đều biến mất cùng container.
# EDGE_HISTORY_DB=
# EDGE_HISTORY_DAYS=30

# =============================================================================
#  TINH CHỈNH — hiếm khi phải đụng
# =============================================================================
# Cấu hình thuật toán của ĐÚNG hộ này, dán từ trang "Cấu hình thuật toán".
# BỎ TRỐNG LÀ DÙNG MẶC ĐỊNH — và nếu hộ đã được tinh chỉnh trên web thì edge sẽ
# tính ra nhiệt độ đặt LỆCH với máy chủ, mà không bên nào báo lỗi.
# EDGE_COMFORT_CONFIG={"ema_alpha":0.2,"deadband":0.8,"dwell_sec":600,"dry_rh":72,"humid_slope":0.05,"clamp_min":24,"clamp_max":28,"override_hours":2,"night_start":23,"night_end":6,"night_offset":0.5}

# Cửa sổ trượt giữ số đo từng góc (giây). Đủ dài để hồi quy có gì mà bám, đủ
# ngắn để một chiều nắng gắt không bị pha loãng bởi buổi sáng mát.
# EDGE_HISTORY_SEC=1800

# Nhịp vòng điều khiển (giây). Không cần dày: nhiệt độ phòng không đổi trong 30
# giây, mà mỗi vòng đều có thể sinh ra một lệnh IR.
# EDGE_TICK_SEC=30

# EDGE_RECONNECT_SEC=5
# EDGE_LOG_LEVEL=INFO

# KHÔNG CẦN EDGE_BACKEND_SRC ở bản App Lab: build-applab-app.py đã chở sẵn lát
# cắt app/comfort/ nằm ngay cạnh edge_ai/, nên `app.comfort` nạp được thẳng.
# Biến đó chỉ dành cho bản chạy bằng systemd (xem ../../../../.env.example).
