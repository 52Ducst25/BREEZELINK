# BreezeLink Edge AI — copy thành .env rồi điền. .env bị gitignore.
#
# KHÔNG CÓ CREDENTIAL MQTT Ở ĐÂY. Dịch vụ này nói chuyện với gateway qua
# Bluetooth, không qua broker — đó chính là điều làm nó sống sót được đúng sự cố
# mất mạng mà nó sinh ra để chịu đựng.

# --- Bắt buộc ---------------------------------------------------------------
# Lấy ở web admin -> Khách hàng -> mở node Gateway trong nhà -> "Nạp firmware".
# Giá trị này được băm thành `link_key`; sai ORG_ID thì gateway lặng lẽ từ chối
# mọi lệnh và log của nó ghi "UNO Q cua ho khac?".
EDGE_ORG_ID=

# --- Tuỳ chọn ---------------------------------------------------------------
# Địa chỉ BLE của gateway. ĐỂ TRỐNG là đúng trong hầu hết trường hợp: dịch vụ tự
# quét theo UUID dịch vụ, nên thay bo gateway không phải sửa gì. Chỉ điền khi
# trong tầm sóng có hai gateway (lắp thử hai hộ cạnh nhau).
# EDGE_GATEWAY_ADDRESS=AA:BB:CC:DD:EE:FF

# Cấu hình thuật toán của ĐÚNG hộ này, dán từ trang "Cấu hình thuật toán".
# BỎ TRỐNG LÀ DÙNG MẶC ĐỊNH — và nếu hộ đã được tinh chỉnh thì edge sẽ tính ra
# nhiệt độ đặt LỆCH với máy chủ, mà không bên nào báo lỗi.
# EDGE_COMFORT_CONFIG={"ema_alpha":0.2,"deadband":0.8,"dwell_sec":600,"dry_rh":72,"humid_slope":0.05,"clamp_min":24,"clamp_max":28,"override_hours":2,"night_start":23,"night_end":6,"night_offset":0.5}

# Chỉ đề xuất, không bao giờ ra lệnh — kể cả khi mất cloud. Bật khi chạy thử tại
# nhà khách để đối chiếu quyết định edge với quyết định cloud trước khi giao cho
# nó quyền thật.
# EDGE_ADVISORY_ONLY=false

# Đường tới thư mục src/ của backend (nơi có app/comfort/). Mặc định là ../src
# tính từ thư mục edge-ai/ — chỉ cần đặt khi triển khai không mang cả cây repo.
# EDGE_BACKEND_SRC=/opt/breezelink/src

# EDGE_HISTORY_SEC=1800
# EDGE_TAKEOVER_AFTER_SEC=300
# EDGE_TICK_SEC=30
# EDGE_SCAN_TIMEOUT_SEC=20
# EDGE_RECONNECT_SEC=5
# EDGE_LOG_LEVEL=INFO
