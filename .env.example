# BreezeLink — environment configuration example.
# Copy to `.env` and adjust. NEVER commit the real `.env`.
# TRAP: changing this file requires restarting BOTH api and worker
# (Pydantic Settings are cached in RAM via @lru_cache).

# --- App ---
APP_NAME=BreezeLink
ENVIRONMENT=development
LOG_LEVEL=INFO

# --- Database (async asyncpg driver; host = compose service name) ---
DB_URL=postgresql+asyncpg://breezelink:breezelink@postgres:5432/breezelink

# --- Redis (state/setpoint/ircache/override cache — activated Phase 2) ---
REDIS_URL=redis://redis:6379/0

# --- JWT (HS256) — CHANGE jwt_secret in production ---
JWT_SECRET=change-me-in-production
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_DAYS=14

# --- MQTT / MQTTS ---
# Prod: EMQX Serverless (cloud managed, NOT self-hosted) — MQTTS on 8883, TLS required.
#   MQTT_HOST=<cluster-id>.ap1.emqxsl.com
#   MQTT_PORT=8883
#   MQTT_TLS=true
# Dev: docker-compose overrides these to a local eclipse-mosquitto broker on
# plaintext 1883 (see docker/docker-compose.yml) — no TLS needed locally.
MQTT_HOST=mosquitto
MQTT_PORT=8883
MQTT_TLS=true
MQTT_USER=breezelink_worker
MQTT_PASS=worker-secret
MQTT_KEEPALIVE=30

# --- Worker ---
WORKER_HEARTBEAT_SECONDS=60

# --- Mailer (SMTP) — password-reset email transport ---
# Dev: leave SMTP_HOST blank -> reset link is logged instead of emailed.
# Prod example (Gmail app-password):
#   SMTP_HOST=smtp-relay.brevo.com  # vd Brevo; de trong = dev, chi ghi log linksmtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=you@gmail.com
#   SMTP_PASS=<16-char app password>
SMTP_HOST=smtp-relay.brevo.com  # vd Brevo; de trong = dev, chi ghi log link
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@vi-du.com  # phai la sender da xac minh trong Brevo
RESET_PASSWORD_URL_BASE=https://quan-tri.vi-du.com/web/reset-password
