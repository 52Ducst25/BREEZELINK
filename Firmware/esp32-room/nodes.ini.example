; Identity of each room-corner sensor board -- ONE ENV PER BOARD.
;
; TEMPLATE: copy to `nodes.ini` and fill it in. (nodes.ini is gitignored because
; it contains a real customer's DEVICE_UUIDs.)
;
; Flashing:
;     pio run -e ss1 -t upload --upload-port COM30
;     pio run -e ss4 -t upload --upload-port COM33
;
; Watching that specific board's log:
        & "$env:USERPROFILE\.platformio\penv\Scripts\pio.exe" device monitor -e ss1 --port COM30
        & "$env:USERPROFILE\.platformio\penv\Scripts\pio.exe" device monitor -e ss2 --port COM31
        & "$env:USERPROFILE\.platformio\penv\Scripts\pio.exe" device monitor -e ss3 --port COM32
        & "$env:USERPROFILE\.platformio\penv\Scripts\pio.exe" device monitor -e ss4 --port COM33

;     pio device monitor -e ss1 --port COM30
;     pio device monitor -e ss2 --port COM31
      pio device monitor -e ss3 --port COM32
      pio device monitor -e ss4 --port COM33
; ---------------------------------------------------------------------------
;  WHY 4 ENVS AND NOT 4 DIRECTORIES
;
;  The four boards run THE SAME firmware and differ in exactly two values.
;  Splitting them into four directories means four copies of main.cpp +
;  room-sensor.cpp: one bug fix has to be applied four times, and on the fourth
;  someone will forget -- then one corner of the room runs an old build and nobody
;  notices, because it still reports perfectly normal readings.
;
;  Envs give exactly what is needed: one flash command per board, one build
;  directory per board (.pio/build/ss1...), and still a single copy of the source.
; ---------------------------------------------------------------------------
;  WHERE TO GET DEVICE_UUID: admin web -> Khách hàng -> open the node
;  (Cảm biến phòng) -> the "Nạp firmware" section. EVERY BOARD NEEDS A DIFFERENT
;  UUID -- duplicate uuids mean two boards overwrite each other's readings on one
;  device row, and the charts jump around for no visible reason.
;
;  ROOM_CORNER 0..3 IS ONLY A DISPLAY LABEL. Duplicates are harmless (the real
;  identity is the uuid), the gateway screen just prints "corner 1" twice.
; ---------------------------------------------------------------------------

[env:ss1]
extends = room_base
build_flags = ${room_base.build_flags}
    -D DEVICE_UUID='"PASTE_DEVICE_UUID_CORNER_1"'
    -D ROOM_CORNER=0

[env:ss2]
extends = room_base
build_flags = ${room_base.build_flags}
    -D DEVICE_UUID='"PASTE_DEVICE_UUID_CORNER_2"'
    -D ROOM_CORNER=1

[env:ss3]
extends = room_base
build_flags = ${room_base.build_flags}
    -D DEVICE_UUID='"PASTE_DEVICE_UUID_CORNER_3"'
    -D ROOM_CORNER=2

[env:ss4]
extends = room_base
build_flags = ${room_base.build_flags}
    -D DEVICE_UUID='"PASTE_DEVICE_UUID_CORNER_4"'
    -D ROOM_CORNER=3
